<Window x:Class="Tla.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TLA · Windows" Width="690" Height="500" MinWidth="470" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="#F3F5F4" Foreground="#172321"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#C8D1CD" />
        </Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="TLA" FontSize="34" FontWeight="SemiBold" />
            <TextBlock Text="이 Windows PC" Foreground="#43554D" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="Targets" AutomationProperties.Name="작업할 Windows 창" DisplayMemberPath="Title"
                      VerticalContentAlignment="Center" SelectionChanged="TargetChanged" />
            <Button Grid.Column="1" Content="창 새로고침" Margin="8,0,0,0" Click="RefreshTargets" />
        </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="#CCD6D1" BorderThickness="1" CornerRadius="8" Padding="16">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="Status" DockPanel.Dock="Top" Text="작업할 앱 창을 선택하세요." TextWrapping="Wrap" />
                <ListBox x:Name="Controls" AutomationProperties.Name="실행 가능한 화면 동작" Margin="0,10,0,0"
                         BorderThickness="0" MouseDoubleClick="ReviewControl" />
            </DockPanel>
        </Border>
        <TextBox x:Name="Instruction" Grid.Row="3" AutomationProperties.Name="TLA에 지시하기" Margin="0,12,0,0"
                 Padding="11,9" BorderBrush="#CCD6D1" MaxLength="400" KeyDown="InstructionKeyDown" />
        <DockPanel Grid.Row="4" Margin="0,10,0,0" LastChildFill="False">
            <Button x:Name="Send" DockPanel.Dock="Right" Content="동작 찾기" Background="#D2E9DC" Click="SubmitInstruction" />
            <Button DockPanel.Dock="Left" Content="선택한 버튼 검토" Click="ReviewControl" />
        </DockPanel>
    </Grid>
</Window>
