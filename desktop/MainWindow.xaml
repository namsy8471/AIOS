<Window x:Class="Tla.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TLA · Windows" Width="860" Height="630" MinWidth="550" MinHeight="450"
        WindowStartupLocation="CenterScreen" Background="#F3F5F4" Foreground="#172321"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#C8D1CD" />
        </Style>
    </Window.Resources>
    <TabControl x:Name="Workspaces" SelectedIndex="1" Margin="16" Background="Transparent" BorderThickness="0">
    <TabItem Header="이 Windows PC">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="TLA" FontSize="34" FontWeight="SemiBold" />
            <TextBlock Text="이 Windows PC" Foreground="#43554D" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="Targets" AutomationProperties.Name="작업할 Windows 창" DisplayMemberPath="Title"
                      VerticalContentAlignment="Center" SelectionChanged="TargetChanged" />
            <Button Grid.Column="1" Content="창 새로고침" Margin="8,0,0,0" Click="RefreshTargets" />
        </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="#CCD6D1" BorderThickness="1" CornerRadius="8" Padding="16">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="Status" DockPanel.Dock="Top" Text="작업할 앱 창을 선택하세요." TextWrapping="Wrap" />
                <ListBox x:Name="Controls" AutomationProperties.Name="실행 가능한 화면 동작" Margin="0,10,0,0"
                         BorderThickness="0" MouseDoubleClick="ReviewControl" />
            </DockPanel>
        </Border>
        <TextBox x:Name="Instruction" Grid.Row="3" AutomationProperties.Name="TLA에 지시하기" Margin="0,12,0,0"
                 Padding="11,9" BorderBrush="#CCD6D1" MaxLength="400" KeyDown="InstructionKeyDown" />
        <DockPanel Grid.Row="4" Margin="0,10,0,0" LastChildFill="False">
            <Button x:Name="Send" DockPanel.Dock="Right" Content="동작 찾기" Background="#D2E9DC" Click="SubmitInstruction" />
            <Button DockPanel.Dock="Left" Content="선택한 버튼 검토" Click="ReviewControl" />
        </DockPanel>
    </Grid>
    </TabItem>
    <TabItem Header="내 휴대폰">
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#E3EBE7" Padding="12" Margin="0,0,10,0" CornerRadius="9">
                <StackPanel>
                    <TextBlock Text="기기" FontSize="18" FontWeight="SemiBold" />
                    <ComboBox x:Name="Phones" AutomationProperties.Name="연결된 휴대폰" Margin="0,9,0,5"
                              SelectionChanged="PhoneChanged" />
                    <Button Content="기기 새로고침" Click="RefreshPhone" />
                    <Expander Header="기기 연결" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="페어링 주소와 코드" Margin="0,5,0,3" />
                            <TextBox x:Name="PairAddress" AutomationProperties.Name="페어링 주소" Padding="5" />
                            <PasswordBox x:Name="PairCode" AutomationProperties.Name="페어링 코드" Padding="5" MaxLength="6" Margin="0,4" />
                            <Button Content="페어링" Click="PairPhone" />
                            <TextBlock Text="무선 연결 주소" Margin="0,8,0,3" />
                            <TextBox x:Name="ConnectAddress" AutomationProperties.Name="무선 디버깅 연결 주소" Padding="5" />
                            <Button Content="연결" Click="ConnectPhone" Margin="0,4,0,0" />
                        </StackPanel>
                    </Expander>
                    <Expander Header="휴대폰 화면" Margin="0,12,0,0">
                        <StackPanel>
                            <Button Content="화면 새로고침" Click="RefreshPhoneImage" />
                            <Image x:Name="PhoneImage" Stretch="Uniform" Cursor="Cross" Height="185" Margin="0,5,0,0"
                                   AutomationProperties.Name="휴대폰 화면" MouseLeftButtonDown="TapPhone" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
            <Grid Grid.Column="1" Margin="6,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="휴대폰에 지시하기" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,12" />
            <Border Grid.Row="1" Background="White" CornerRadius="9" BorderBrush="#D6DEDA" BorderThickness="1">
                <ListBox x:Name="PhoneConversation" AutomationProperties.Name="휴대폰 대화" Background="Transparent" BorderThickness="0"
                         Padding="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="11,8" Margin="0,3" Background="#EDF3EF" CornerRadius="9">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <Border Grid.Row="2" Background="White" BorderBrush="#C8D6CF" BorderThickness="1" CornerRadius="11" Padding="6" Margin="0,10,0,0">
                <DockPanel LastChildFill="True">
                    <Button x:Name="SendPhone" DockPanel.Dock="Right" Content="보내기" Background="#D2E9DC" Click="SubmitPhone" />
                    <TextBox x:Name="PhoneInstruction" AutomationProperties.Name="휴대폰에 보낼 지시" ToolTip="예: 메모 보여줘"
                             BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="8,6"
                             MaxLength="400" KeyDown="PhoneInstructionKeyDown" />
                </DockPanel>
            </Border>
            <TextBlock Grid.Row="3" x:Name="PhoneStatus" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="휴대폰에서 무선 디버깅을 켜고, 페어링 팝업의 주소와 코드를 입력하세요." />
            </Grid>
        </Grid>
    </TabItem>
    </TabControl>
</Window>
